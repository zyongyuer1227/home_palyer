# Android SDK path. Android Studio usually creates local.properties automatically.
sdk.dir=/path/to/Android/Sdk

# Optional release signing settings.
# Keep real keystores and passwords out of git.
IPTV_RELEASE_STORE_FILE=keystore/iptv-release.jks
IPTV_RELEASE_KEY_ALIAS=release
IPTV_RELEASE_STORE_PASSWORD=change-me
IPTV_RELEASE_KEY_PASSWORD=change-me
